<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cadence.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cadence">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Eigene Titelleiste -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Canvas Width="16" Height="16" VerticalAlignment="Center">
                    <Rectangle Canvas.Left="1.5" Canvas.Top="3" Width="2.4" Height="10" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource CadenceAccentBrush}" />
                    <Rectangle Canvas.Left="6.8" Canvas.Top="3" Width="2.4" Height="10" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource CadenceAccentBrush}" />
                    <Rectangle Canvas.Left="12.1" Canvas.Top="3" Width="2.4" Height="10" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource CadenceAccentBrush}" />
                </Canvas>
                <TextBlock Text="Cadence" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="232"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Übersicht" Tag="overview" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Profile" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Statistiken" Tag="stats">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Overlay" Tag="overlay">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Globale Hinweise -->
                <StackPanel Margin="32,16,32,0" Spacing="8">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                            <EntranceThemeTransition FromVerticalOffset="-12" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                    <InfoBar x:Name="SuggestBar" Severity="Informational" IsOpen="False">
                        <InfoBar.ActionButton>
                            <Button Content="Profil anlegen" Click="SuggestBar_Create" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar x:Name="BlockedBar" Severity="Warning" IsOpen="False" Title="Anti-Cheat erkannt" />
                    <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" Title="Fehler" />
                </StackPanel>

                <Frame x:Name="ContentFrame" Grid.Row="1">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                    <EntranceNavigationTransitionInfo />
                                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </Grid>
        </NavigationView>

        <!-- Splash-Screen beim Start: pulsierendes Logo und Ladebalken. Klick ueberspringt. -->
        <Grid x:Name="Splash" Grid.RowSpan="2" Background="#1C1C1C" Tapped="Splash_Tapped">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="26">
                <Grid Width="74" Height="58" HorizontalAlignment="Center">
                    <Rectangle Width="14" Height="58" RadiusX="7" RadiusY="7" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               Fill="{StaticResource CadenceAccentBrush}" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="Bar1Scale" ScaleY="0.3" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="14" Height="58" RadiusX="7" RadiusY="7" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Fill="{StaticResource CadenceAccentBrush}" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="Bar2Scale" ScaleY="0.3" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="14" Height="58" RadiusX="7" RadiusY="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Fill="{StaticResource CadenceAccentBrush}" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="Bar3Scale" ScaleY="0.3" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>

                <StackPanel x:Name="SplashTitle" Spacing="4" Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="TitleShift" Y="10" />
                    </StackPanel.RenderTransform>
                    <TextBlock Text="Cadence" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Präziser FPS-Limiter" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Width="240" Spacing="10">
                    <Grid Height="3" CornerRadius="1.5" Background="#2E2E2E">
                        <Rectangle Fill="{StaticResource CadenceAccentBrush}" RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <TextBlock x:Name="SplashStatus" Text="Starte …" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="SplashVersion" Style="{StaticResource CaptionStyle}" Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" />
        </Grid>
    </Grid>
</Window>

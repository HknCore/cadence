<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Cadence.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Eigene Farben. Der lila Akzent fuer die WinUI-Steuerelemente wird in App.xaml.cs gesetzt. -->
            <SolidColorBrush x:Key="CadenceAccentBrush" Color="#B9A3FF" />
            <SolidColorBrush x:Key="CadenceWarnBrush" Color="#E0A458" />
            <SolidColorBrush x:Key="CadenceGridBrush" Color="#2C2C2C" />

            <!-- Einheitliche Karten im Stil der Windows-Einstellungen -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="StatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cadence.App.Pages.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Cadence.App.Pages"
    Background="Transparent">

    <Grid Padding="32,20,32,28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Statistiken" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SessionInfo" Style="{StaticResource CaptionStyle}"
                           Text="Starte eine Aufnahme, während ein Spiel läuft." />
            </StackPanel>
            <Button x:Name="CsvButton" Grid.Column="1" Content="Als CSV exportieren" IsEnabled="False" Click="Csv_Click" VerticalAlignment="Bottom" />
            <Button x:Name="ImageButton" Grid.Column="2" Content="Als Bild speichern" IsEnabled="False" Click="Image_Click" VerticalAlignment="Bottom" />
            <Button x:Name="RecordButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="Record_Click" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="RecDot" Width="8" Height="8" Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <TextBlock x:Name="RecordText" Text="Aufnehmen" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Kennzahlen -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20,16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Ø FPS" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="AvgText" Text="–" Style="{StaticResource StatValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="1 % Low" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="Low1Text" Text="–" Style="{StaticResource StatValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="0,1 % Low" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="Low01Text" Text="–" Style="{StaticResource StatValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="2">
                    <TextBlock Text="σ Frametime" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="SdText" Text="–" Style="{StaticResource StatValueStyle}" Foreground="{StaticResource CadenceAccentBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="2">
                    <TextBlock Text="Stotterer" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="StutterText" Text="–" Style="{StaticResource StatValueStyle}" Foreground="{StaticResource CadenceAccentBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <!-- Verteilung -->
            <Border x:Name="HistogramCard" Style="{StaticResource CardStyle}" Padding="20,16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Verteilung der Frametimes" />
                        <TextBlock x:Name="CenterText" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" />
                    </Grid>
                    <Grid x:Name="Bars" Grid.Row="1" ColumnSpacing="6" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" />
                    <Grid x:Name="BarLabels" Grid.Row="2" ColumnSpacing="6" />
                </Grid>
            </Border>

            <!-- Vergleich -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20,16">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Aufnahmen dieser Sitzung" />
                    <Grid Grid.Row="1" Padding="12,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Aufnahme" Style="{StaticResource CaptionStyle}" />
                        <TextBlock Grid.Column="1" Text="Ø FPS" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="1 % Low" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="0,1 % Low" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="σ" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Stotterer" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                    </Grid>
                    <ListView x:Name="SessionList" Grid.Row="2" ItemsSource="{x:Bind Sessions}" SelectionMode="Single"
                              SelectionChanged="SessionList_SelectionChanged">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="pages:SessionRow">
                                <Grid Padding="0,10" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Avg}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Low1}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Low01}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Sd}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Stutters}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="3" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                               Text="Stotterer = Frames, die länger als das Doppelte der mittleren Frametime brauchen. Für faire Vergleiche dieselbe Szene gleich lang aufnehmen." />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

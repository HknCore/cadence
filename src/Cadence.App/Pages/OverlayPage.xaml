<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cadence.App.Pages.OverlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="32,20,32,28" Spacing="4">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <TextBlock Text="Overlay" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

            <Border Style="{StaticResource CardStyle}" Padding="20,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Overlay im Spiel anzeigen" />
                        <TextBlock Text="Ein- und ausblenden auch im Spiel mit Strg + Alt + O" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="EnabledSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                  AutomationProperties.Name="Overlay anzeigen" Toggled="Enabled_Toggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="20,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Darstellung" />
                        <TextBlock x:Name="VariantHint" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <controls:Segmented x:Name="VariantBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="Variant_Changed">
                        <controls:SegmentedItem Content="Minimal" />
                        <controls:SegmentedItem Content="Kompakt" />
                        <controls:SegmentedItem Content="Detail" />
                    </controls:Segmented>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="20,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Position" />
                        <TextBlock Text="Ecke des Spielfensters" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="CornerBox" Grid.Column="1" MinWidth="180" VerticalAlignment="Center"
                              AutomationProperties.Name="Position" SelectionChanged="Corner_Changed">
                        <ComboBoxItem Content="Oben links" />
                        <ComboBoxItem Content="Oben rechts" />
                        <ComboBoxItem Content="Unten links" />
                        <ComboBoxItem Content="Unten rechts" />
                    </ComboBox>
                </Grid>
            </Border>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,12,0,0"
                     Title="Gut zu wissen"
                     Message="Das Overlay schwebt über dem Spielfenster und funktioniert im Fenster- und im randlosen Vollbildmodus. Im exklusiven Vollbild blendet Windows es aus – stelle das Spiel dann auf „Randlos“ bzw. „Borderless“. Pro Spiel lässt es sich unter „Profile“ abschalten." />
        </StackPanel>
    </ScrollViewer>
</Page>

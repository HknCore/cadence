<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cadence.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="32,20,32,28" Spacing="4" MaxWidth="900" HorizontalAlignment="Stretch">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <TextBlock Text="Einstellungen" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

            <Border Style="{StaticResource CardStyle}" Padding="20,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Mit Windows starten" />
                        <TextBlock Text="Cadence startet minimiert und wendet Profile automatisch an." Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutostartSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                  AutomationProperties.Name="Mit Windows starten" Toggled="Autostart_Toggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="20,14">
                <StackPanel Spacing="2">
                    <TextBlock Text="Hotkeys" />
                    <TextBlock x:Name="HotkeyStatus" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="20,14">
                <StackPanel Spacing="2">
                    <TextBlock Text="Schutz vor Anti-Cheat-Sperren" />
                    <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                               Text="Cadence prüft jedes Spiel vor dem Einklinken auf Anti-Cheat (z. B. Easy Anti-Cheat, BattlEye, Vanguard, VAC-Spiele). Erkannte Spiele werden nie angefasst. Die Erkennung ist nicht vollständig: Nutze Cadence nicht in Online-Spielen mit Anti-Cheat." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="20,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Profile" />
                        <TextBlock x:Name="ProfilePath" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Ordner öffnen" Click="OpenFolder_Click" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="20,14">
                <StackPanel Spacing="2">
                    <TextBlock Text="Über Cadence" />
                    <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                               x:Name="AboutText" Text="Unterstützt 64-Bit-Spiele mit DirectX 10, 11, 12 und OpenGL. Vulkan und 32-Bit-Spiele folgen." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

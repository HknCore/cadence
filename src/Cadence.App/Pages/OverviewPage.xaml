<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cadence.App.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Cadence.App.Controls"
    Background="Transparent">

    <Grid Padding="32,20,32,28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <!-- Kopf: Spiel + Hauptschalter -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center"
                             Fill="{x:Bind StatusBrush(Vm.StatusOk), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="{x:Bind Vm.GameName, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind Vm.GameDetails, Mode=OneWay}" Style="{StaticResource CaptionStyle}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" VerticalAlignment="Bottom" MinWidth="0"
                          OnContent="Limiter an" OffContent="Limiter aus"
                          IsOn="{x:Bind Vm.IsEnabled, Mode=TwoWay}" />
        </Grid>

        <!-- Einstellungen fuer das aktive Spiel -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" IsHitTestVisible="{x:Bind Vm.HasGame, Mode=OneWay}"
                Opacity="{x:Bind CardOpacity(Vm.HasGame), Mode=OneWay}">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.3" />
            </Border.OpacityTransition>
            <StackPanel>
                <Grid Padding="20,16" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Ziel-FPS" />
                        <TextBlock Style="{StaticResource CaptionStyle}">
                            <Run Text="{x:Bind Vm.TargetFrametime, Mode=OneWay}" /><Run Text=" pro Bild · im Spiel mit Strg + Alt + ↑ / ↓" />
                        </TextBlock>
                    </StackPanel>
                    <controls:Segmented Grid.Column="1" VerticalAlignment="Center"
                                        SelectedIndex="{x:Bind Vm.PresetIndex, Mode=TwoWay}">
                        <controls:SegmentedItem Content="30" />
                        <controls:SegmentedItem Content="40" />
                        <controls:SegmentedItem Content="45" />
                        <controls:SegmentedItem Content="60" />
                        <controls:SegmentedItem Content="90" />
                        <controls:SegmentedItem Content="120" />
                        <controls:SegmentedItem Content="144" />
                    </controls:Segmented>
                    <NumberBox Grid.Column="2" Width="132" VerticalAlignment="Center"
                               Minimum="10" Maximum="1000" SmallChange="1" LargeChange="10"
                               SpinButtonPlacementMode="Inline"
                               AutomationProperties.Name="Ziel-FPS"
                               Value="{x:Bind Vm.TargetFps, Mode=TwoWay}" />
                </Grid>
                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Grid Padding="20,16" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Modus" />
                        <TextBlock Text="{x:Bind Vm.ModeDescription, Mode=OneWay}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <controls:Segmented Grid.Column="1" VerticalAlignment="Center" MinWidth="408"
                                        SelectedIndex="{x:Bind Vm.ModeIndex, Mode=TwoWay}">
                        <controls:SegmentedItem Content="Ausgewogen" />
                        <controls:SegmentedItem Content="Niedrige Latenz" />
                        <controls:SegmentedItem Content="Max. Glätte" />
                    </controls:Segmented>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Live-Graph -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="20,16">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Frametime" VerticalAlignment="Bottom" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                        <TextBlock Text="{x:Bind Vm.FrametimeNow, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Text="ms" Style="{StaticResource CaptionStyle}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                    </StackPanel>
                </Grid>

                <local:FrametimeGraph x:Name="Graph" Grid.Row="1" />
                <TextBlock Grid.Row="1" Text="Sobald ein Spiel läuft, erscheint hier der Live-Verlauf."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource CaptionStyle}"
                           Visibility="{x:Bind Vm.NoGame, Mode=OneWay}" />

                <Grid Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Ø FPS" Style="{StaticResource CaptionStyle}" />
                        <TextBlock Text="{x:Bind Vm.AvgFps, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="1 % Low" Style="{StaticResource CaptionStyle}" />
                        <TextBlock Text="{x:Bind Vm.Low1, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="0,1 % Low" Style="{StaticResource CaptionStyle}" />
                        <TextBlock Text="{x:Bind Vm.Low01, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="2">
                        <TextBlock Text="Abweichung" Style="{StaticResource CaptionStyle}" />
                        <TextBlock Text="{x:Bind Vm.Deviation, Mode=OneWay}" Style="{StaticResource StatValueStyle}"
                                   Foreground="{StaticResource CadenceAccentBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>

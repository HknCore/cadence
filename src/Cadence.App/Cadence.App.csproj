<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Cadence.App</RootNamespace>
    <AssemblyName>Cadence</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- unpaketierte App: laeuft direkt als .exe, kein MSIX noetig -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Auch ohne MSIX noetig: erzeugt resources.pri (XAML-Ressourcen). Ohne sie stuerzt die
         veroeffentlichte App beim Start kommentarlos ab (WindowsAppSDK #3718). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <!-- noetig fuer [LibraryImport] (Windows-Funktionsaufrufe, z. B. im CrashReporter) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\Cadence.ico</ApplicationIcon>

    <!-- Kleinere Installation -->
    <!-- nur deutsche und englische Sprachressourcen mitliefern -->
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <!-- beim Veröffentlichen ungenutzte Teile der .NET-Bibliotheken entfernen.
         "partial": nur Microsoft-Bibliotheken werden gekürzt, Cadence-Code bleibt unangetastet. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Diagnose- und Debugger-Hilfen, die eine Endanwender-App nicht braucht -->
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Nur die Teile des Windows App SDK, die Cadence braucht. Das Gesamtpaket
         "Microsoft.WindowsAppSDK" brächte KI/ML (ONNX Runtime), Widgets u. a. mit (~100 MB mehr).
         Versionen entsprechen dem Gesamtpaket 1.8.260921001. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="1.8.251216001" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260803002" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="1.8.260708001" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cadence.Core\Cadence.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Die Hook-DLL wird von build.ps1 nach build\hook\ gebaut und hier mitkopiert. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\hook\CadenceHook.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\build\hook\CadenceHook.dll"
          Link="CadenceHook.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="WarnMissingHook" BeforeTargets="Build"
          Condition="!Exists('$(MSBuildThisFileDirectory)..\..\build\hook\CadenceHook.dll')">
    <Warning Text="CadenceHook.dll fehlt. Zuerst build.ps1 ausführen (baut die Hook-DLL)." />
  </Target>

</Project>

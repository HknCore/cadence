<Project>
  <!--
    dotnet publish vergisst bei unpaketierten WinUI-Apps die .pri-Datei (WindowsAppSDK #6720).
    Ohne sie findet die App ihre XAML-Ressourcen nicht und beendet sich sofort.
    Dieses Ziel nimmt die Datei in den Publish-Ordner auf. Ist der Fehler behoben, bleibt es wirkungslos.
  -->
  <Target Name="CadenceAddPriToPublish"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(UseWinUI)' == 'true'">
    <ItemGroup>
      <_CadencePri Include="$(OutDir)*.pri" />
      <ResolvedFileToPublish Include="@(_CadencePri)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
